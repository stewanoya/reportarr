{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "System.Net.Http.HttpClient": "Warning",
      "Microsoft.Hosting.Lifetime": "Warning"
    }
  },
  "HealthCheck": {
    "BaseUrl": "https://example-url.ca",
    "Endpoint": "health",
    "Interval": 60000
  },
  "Discord": {
    "Token": "your-token",
    "ApplicationId": "your-app-id",
    "PublicKey": "your-publicKey",
    "ChannelId": "channel-id",
    "AdminUserId": "tagged-user-id"
  },
  "Support": {
    "RemoteSupportEnabled": true,
    "HostOs": "Windows",
    "AllowedCommands": ["Restart"],
    "ScriptsPath": "~"
  },
  "Sonarr": {
    "Enabled": false,
    "BaseUrl": "https://your-sonarr-url.ca",
    "ApiKey": "your-sonarr-api-key",
    "RefreshInterval": 60000
  },
  "Radarr": {
    "Enabled": false,
    "BaseUrl": "https://your-radarr-url.ca",
    "ApiKey": "your-radarr-api-key",
    "RefreshInterval": 60000
  }
}
